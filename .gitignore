# 의존성 / 빌드 결과물
node_modules/
dist/

# 비밀값이 들어갈 환경 변수 (.env.example, .env.development 는 커밋)
.env
.env.local
.env.*.local

# 시나리오 에디터가 만드는 이전 버전/삭제 보관 (scenario.yaml, meta.json 은 커밋)
scenarios/*/.versions/
scenarios/.trash/
*.yaml.tmp
*.json.tmp

# 엑셀/오피스 임시 잠금 파일
~$*

# OS / 에디터
.DS_Store
Thumbs.db
.vscode/
.idea/

# 로그
*.log
