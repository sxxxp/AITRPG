PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# 시나리오 폴더 (기본: 저장소 루트의 scenarios/)
SCENARIO_DIR=
DATABASE_URL=postgresql://wtg:wtg@localhost:5432/wtg
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# ── LLM ──
# ollama : Ollama 네이티브 API (기본, 로컬 GPU)
# openai : OpenAI 호환 API (vLLM, llama.cpp server, 무료 API 등) — LLM_BASE_URL 은 /v1 까지
# none   : LLM 없이 엔진 + 시나리오 고정 문장으로만 진행
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
# RTX 2060 6GB 권장: gemma3:4b (기본) / qwen3:4b (LLM_THINK=false) / exaone3.5:2.4b (비상업 라이선스)
LLM_MODEL=gemma3:4b
LLM_API_KEY=
# Qwen3 등 추론 모델은 false 로 두어 생각 과정 토큰을 생략. 일반 모델은 비워 둘 것
LLM_THINK=
# 컨텍스트 길이. 6GB VRAM 에서는 4096 권장 (늘리면 VRAM 사용량 증가)
LLM_NUM_CTX=4096
LLM_TIMEOUT_MS=90000
